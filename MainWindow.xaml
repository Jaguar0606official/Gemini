<Window x:Class="GeminiNetworkAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Network Assistant" Height="760" Width="1180"
        MinHeight="650" MinWidth="960" WindowStartupLocation="CenterScreen"
        Background="#111827" Foreground="#F3F4F6">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Gemini Network Assistant" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Сетевая диагностика и управление DNS" Foreground="#9CA3AF" Margin="0,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#263449" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="MVP 0.4" Foreground="#C7D2FE" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1" Background="#111827" BorderBrush="#374151" Foreground="#F3F4F6">
            <TabItem Header="Диагностика сети">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Проверка подключения к Google" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Проверка DNS, TCP 443 и HTTPS. Системные настройки не меняются."
                                   Foreground="#9CA3AF" Margin="0,5,0,12"/>
                        <Button x:Name="RunDiagnosticsButton" Content="Запустить диагностику"
                                Click="RunDiagnostics_Click" Padding="14,9" HorizontalAlignment="Left"
                                Background="#6577E8" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,14,0,0"
                             Background="#0B1220" Foreground="#D1D5DB" BorderBrush="#374151"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem Header="DNS Manager">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Управление DNS Windows" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Выбери сетевой адаптер и DNS-провайдера. Для изменения настроек запусти программу от имени администратора."
                                   Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,5,0,12"/>
                        <WrapPanel>
                            <ComboBox x:Name="AdapterBox" Width="330" Padding="7" Margin="0,0,8,8"
                                      DisplayMemberPath="DisplayName"/>
                            <Button Content="Обновить адаптеры" Click="RefreshAdapters_Click" Padding="12,7" Margin="0,0,8,8"/>
                            <ComboBox x:Name="DnsProviderBox" Width="190" Padding="7" Margin="0,0,8,8">
                                <ComboBoxItem Content="Cloudflare (1.1.1.1)" Tag="1.1.1.1;1.0.0.1" IsSelected="True"/>
                                <ComboBoxItem Content="Google (8.8.8.8)" Tag="8.8.8.8;8.8.4.4"/>
                                <ComboBoxItem Content="Quad9 (9.9.9.9)" Tag="9.9.9.9;149.112.112.112"/>
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Применить DNS" Click="ApplyDns_Click" Padding="14,9" Margin="0,0,8,8"
                                    Background="#6577E8" Foreground="White" BorderThickness="0"/>
                            <Button Content="Восстановить DNS до запуска" Click="RestoreDns_Click" Padding="14,9" Margin="0,0,8,8"/>
                            <Button Content="Показать текущий DNS" Click="ShowDns_Click" Padding="14,9" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBox x:Name="DnsLogBox" Grid.Row="1" Margin="0,10,0,0" MinHeight="190"
                             Background="#0B1220" Foreground="#D1D5DB" BorderBrush="#374151"
                             FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Grid.Row="2" Text="Важно: смена DNS влияет только на разрешение доменных имён. Она не меняет внешний IP, страну аккаунта или региональную доступность Google. Снимок DNS хранится только до закрытия программы. Если адаптер использовал автоматическое получение DNS (DHCP), восстановление исходного режима после ручной смены DNS может потребовать сброса DNS-настроек адаптера."
                               Foreground="#FCD34D" TextWrapping="Wrap" Margin="0,12,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>

            <TabItem Header="О программе">
                <StackPanel Margin="18" MaxWidth="800" HorizontalAlignment="Left">
                    <TextBlock Text="Gemini Network Assistant 0.4" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Утилита проверяет сетевое подключение к контрольным адресам Google и позволяет вручную менять DNS-серверы выбранного сетевого адаптера."
                               Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="Изменение DNS не меняет внешний IP, страну аккаунта и не гарантирует доступ к сервисам, ограниченным по региону. Настройки DNS меняются только по нажатию соответствующей кнопки."
                               Foreground="#FCD34D" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="Перед изменением DNS рекомендуется сохранить текущие настройки сети." Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="Сетевая диагностика • управление DNS • изменения выполняются только вручную"
                   Foreground="#6B7280" Margin="0,12,0,0"/>
    </Grid>
</Window>
