<Window x:Class="GeminiNetworkAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Network Assistant" Height="720" Width="1120"
        MinHeight="620" MinWidth="920" WindowStartupLocation="CenterScreen"
        Background="#111827" Foreground="#F3F4F6">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Gemini Network Assistant" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Сетевая диагностика и локальный AI — начальная версия"
                           Foreground="#9CA3AF" Margin="0,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#263449" CornerRadius="12"
                    Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="MVP 0.1" Foreground="#C7D2FE" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Background="#202938" CornerRadius="12" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Сеть" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="NetworkStatus" Text="Не проверялась" FontSize="19"
                               FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#202938" CornerRadius="12" Padding="15" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="DNS" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="DnsStatus" Text="Не проверялся" FontSize="19"
                               FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#202938" CornerRadius="12" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Google endpoints" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="GoogleStatus" Text="Не проверялись" FontSize="19"
                               FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#202938" CornerRadius="14" Padding="18" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Диагностика подключения" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Проверяем DNS, TCP 443 и HTTPS-ответы. Проверка не меняет настройки Windows."
                                   Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,7,0,14"/>
                        <Button x:Name="RunDiagnosticsButton" Content="Запустить диагностику"
                                Click="RunDiagnostics_Click" Padding="14,10" HorizontalAlignment="Left"
                                Background="#6577E8" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Margin="0,16,0,0"
                             Background="#111827" Foreground="#D1D5DB" BorderBrush="#374151"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#202938" CornerRadius="14" Padding="18" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Режимы работы" FontSize="20" FontWeight="SemiBold"/>
                    <Border Background="#172235" CornerRadius="10" Padding="13" Margin="0,14,0,10">
                        <StackPanel>
                            <TextBlock Text="Google services" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Проверка доступности Gemini и инфраструктурных адресов Google. Результат сетевой проверки не подтверждает региональную доступность аккаунта."
                                       Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Статус: диагностика доступна" Foreground="#A7F3D0" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#172235" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Local AI" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Следующий модуль: подключение Ollama для локальных моделей без облачного сервера."
                                       Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Статус: подготовлен к интеграции" Foreground="#FDE68A" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Важно" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <TextBlock Text="Программа не обходит региональные ограничения Google. DNS-переключение не меняет страну аккаунта или внешний IP. Автоматическое изменение сетевых настроек пока намеренно отключено."
                               Foreground="#9CA3AF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="Локальная диагностика • настройки сети не изменяются"
                       Foreground="#6B7280" VerticalAlignment="Center"/>
            <TextBlock Text="Gemini Network Assistant" Foreground="#6B7280"
                       DockPanel.Dock="Right" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
